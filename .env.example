# Required
ANTHROPIC_API_KEY=your-anthropic-key

# Models (provider:model). These are the defaults.
REVIEWER_MODEL=anthropic:claude-sonnet-5-5
CRITIC_MODEL=anthropic:claude-opus-5-5
SIMULATED_USER_MODEL=anthropic:claude-haiku-4-5

# Optional: LangSmith tracing
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=your-langsmith-key
# EU accounts: https://eu.api.smith.langchain.com
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=code-reviewer
